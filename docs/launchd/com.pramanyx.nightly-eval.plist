<?xml version="1.0" encoding="UTF-8"?>
<!--
  F1 — the nightly evaluation (evals/nightly.py, docs/TENX_PROGRAM_2026-11-05.md Track F).
  NOT INSTALLED. To turn it on (the operator's step):

      cp docs/launchd/com.pramanyx.nightly-eval.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.pramanyx.nightly-eval.plist

  To turn it off:   launchctl unload ~/Library/LaunchAgents/com.pramanyx.nightly-eval.plist
  To run it now:    launchctl start com.pramanyx.nightly-eval

  It runs at 03:30 on a COPY of the newest hourly backup (never the live state), spends at most the
  ceiling (default $5; to change it, append the ceiling-usd flag and its value as two more strings
  after the env file, as evals/README.md shows), writes evals/nightly_out/<date>/nightly-<time>.{json,md} in the checkout, and exits
  1 when a regression budget is broken. A Mac asleep at 03:30 runs it on waking.

  The env file is read for three keys only: PRAMANYX_SECRET_KEY (the copy's stored credentials decrypt
  with it), PRAMANYX_DEFAULT_POSTGRES_DSN and PRAMANYX_MODEL_PRICES. The models the install answers with
  must be priced there (provider:model=input/output@date, USD per 1M tokens) or the night refuses to
  start: a ceiling that cannot price a call cannot hold.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pramanyx.nightly-eval</string>
    <key>WorkingDirectory</key>
    <string>/Users/amitkamlapure/dev/pramanyx</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--all-extras</string>
        <string>python</string>
        <string>-m</string>
        <string>evals.nightly</string>
        <string>from-backup</string>
        <string>--env-file</string>
        <string>/Users/amitkamlapure/dev/pramanyx/.env</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/amitkamlapure/.config/pramanyx/nightly-eval.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/amitkamlapure/.config/pramanyx/nightly-eval.log</string>
</dict>
</plist>
