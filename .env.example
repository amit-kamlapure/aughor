# Copy to .env and fill in values.
# LLM settings here are the FALLBACK layer: anything saved in Settings → Models
# in the web UI (data/llm_config.json) takes precedence over this file.

# LLM backend: "ollama" (local, the default) | "lmstudio" (local) |
#              "groq" | "together" | "anthropic" | "gemini" | "openrouter"
#              (the hosted ones need an API key)
PRAMANYX_BACKEND=ollama

# ── Ollama (PRAMANYX_BACKEND=ollama — the default) ─────────────────────────────
# Needs Ollama running locally (https://ollama.com). CAVEAT: the built-in default
# models are Ollama *cloud-tier* (qwen3-coder-next:cloud / kimi-k2.6:cloud), which
# require `ollama signin`. For a fully-local setup, pull a model and pin it:
#   ollama pull qwen2.5-coder:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# PRAMANYX_CODER_MODEL=qwen2.5-coder:14b
# PRAMANYX_NARRATOR_MODEL=qwen2.5-coder:14b

# ── LM Studio (PRAMANYX_BACKEND=lmstudio — local, no key) ──────────────────────
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# PRAMANYX_CODER_MODEL=local-model

# ── Groq (PRAMANYX_BACKEND=groq — hosted, key required) ────────────────────────
# GROQ_API_KEY=gsk_...
# PRAMANYX_CODER_MODEL=llama-3.3-70b-versatile   # default for groq
# PRAMANYX_NARRATOR_MODEL=llama-3.3-70b-versatile

# ── Together (PRAMANYX_BACKEND=together — hosted, key required) ────────────────
# TOGETHER_API_KEY=...
# PRAMANYX_CODER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# PRAMANYX_NARRATOR_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── Anthropic (PRAMANYX_BACKEND=anthropic — hosted, key required) ──────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (PRAMANYX_BACKEND=gemini — hosted, key required) ────────────────────
# Google Gemini via its OpenAI-compatible endpoint. A fresh key runs immediately
# on the built-in default (gemini-3.1-flash-lite, pinned for its larger free-tier
# request budget). On a paid key, set PRAMANYX_CODER_MODEL=gemini-pro-latest.
# GEMINI_API_KEY=...

# ── OpenRouter (PRAMANYX_BACKEND=openrouter — hosted, key required) ─────────────
# One key, many vendors, OpenAI-compatible. The built-in defaults are free-tier
# ids, so a fresh key runs immediately; browse the live catalogue in
# Settings → Models to reach paid models.
# OPENROUTER_API_KEY=sk-or-...
# PRAMANYX_CODER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# PRAMANYX_NARRATOR_MODEL=google/gemma-4-31b-it:free

# ── TypeSafe Jev (OPTIONAL judgment backend — not an PRAMANYX_BACKEND) ─────────
# JD-5: with PRAMANYX_SEMOPS_JEV_CHEAP_TIER=1, the banded semantic filter's CHEAP
# tier is judged by TypeSafe's Jev instead of your LLM's fast role — measured
# +2.6 points over the sampled cascade at ~2.6x lower cost
# (evals/jd5_jev_receipt.json). Row text LEAVES THE BOX to TypeSafe:
# every call rides the outbound seam (usage caps + EXTERNAL_CALL events), a
# bundle with any redactable PII is withheld and judged in-house, and if Jev is
# down or unconfigured the house tier answers — an outage is yesterday's
# cascade, never worse. BOTH lines below are required; no model id ships as a
# default (the vendor documents "jev-latest").
# TYPESAFE_API_KEY=apik...
# PRAMANYX_JEV_MODEL=jev-latest
# PRAMANYX_SEMOPS_JEV_CHEAP_TIER=1

# Max investigative iterations before forcing synthesis (default 6)
# PRAMANYX_MAX_ITER=6

# Default Postgres connection — pre-loaded as a built-in on every startup.
# If set, this becomes the default connection in the UI instead of the fixture DB.
# PRAMANYX_DEFAULT_POSTGRES_DSN=postgresql://user:pass@localhost:5432/mydb

# SQL Knowledge Base — the knowledge packages (packs/*/kb/*.json) are embedded into Qdrant and used
# to guide SQL generation and self-correction. No setting is needed; PRAMANYX_KB_PATH only OVERRIDES
# the packages with a flat folder of KB JSONs.
# PRAMANYX_KB_PATH=/absolute/path/to/a/folder/of/kb/jsons
# PRAMANYX_KB_ENABLED=true   # set to "false" to disable the knowledge base retriever

# Industries — which industry packages Pramanyx reads. The installer asks once and writes the answer to
# data/industries.json; change it in Settings → Organization or with `pramanyx industries`. No file keeps
# every industry, each connection's detected from its data. PRAMANYX_INDUSTRIES answers the installer's
# question ahead (retail,saas · all · none); PRAMANYX_INDUSTRIES_FILE moves the file.
# PRAMANYX_INDUSTRIES=retail,saas
# PRAMANYX_INDUSTRIES_FILE=/absolute/path/to/industries.json

# Vector store. Unset, semantic search runs EMBEDDED (in-process, on disk at
# PRAMANYX_QDRANT_PATH, default data/qdrant) — no server, no second install step.
# Set PRAMANYX_QDRANT_URL only to pin an external Qdrant server instead (an existing
# server keeps its vectors; docker-compose.yml brings one up). One process per
# embedded path — the API owns it; scripts talk to the API, never the directory.
# PRAMANYX_QDRANT_URL=http://localhost:6333
# PRAMANYX_QDRANT_PATH=data/qdrant

# ── Exposing Pramanyx beyond localhost ─────────────────────────────────────────
# Pramanyx's defaults assume a trusted, single-user, local machine. Set these
# before you put it on a network. See SECURITY.md.

# Shared-secret front door. UNSET BY DEFAULT — the API is open. When set, every
# request must carry it as the `X-Api-Key` header (/health, /docs, /redoc and
# /openapi.json stay open so probes and the schema browser keep working).
# PRAMANYX_API_KEY=

# Browser origins allowed to call the API.
# Default: http://localhost:3000,http://localhost:3001,http://localhost:3210
# PRAMANYX_CORS_ORIGINS=http://localhost:3000

# Fernet key used to encrypt stored connection credentials at rest. If unset, a
# key is generated and written to data/.pramanyx_key with mode 0600. Set it
# explicitly to share one key across machines — losing it makes saved
# connections undecryptable.
# PRAMANYX_SECRET_KEY=

# Require a caller identity (X-Pramanyx-Org) on every request. Off by default,
# which keeps the single-user local behaviour.
# PRAMANYX_REQUIRE_IDENTITY=

# With identity required, the API must be able to VERIFY it, or it refuses every request
# (but /health and /auth/config, which say why). Either an OIDC issuer + audience:
# PRAMANYX_OIDC_ISSUER=
# PRAMANYX_OIDC_AUDIENCE=
# …or, only when an authenticating proxy in front of the API sets X-Pramanyx-Org and
# X-Pramanyx-User and strips them from clients, the operator's declaration of that fact:
# PRAMANYX_IDENTITY_FROM_PROXY=

# How long a browser session lives from sign-in (seconds). The sign-in exchanges the
# identity provider's token once for an HttpOnly cookie; the page never holds the token.
# PRAMANYX_SESSION_TTL_S=43200

# ── Observability (MLflow tracing) ───────────────────────────────────────────
# Trace every deep analysis to a self-hosted MLflow server (graph nodes, LLM
# calls with token counts, guarded SQL as TOOL spans; searchable by
# tags.investigation_id). Needs the observability extra, which the installer already syncs
# (by hand: uv sync --all-extras — `uv sync --extra observability` alone removes every other extra)
# and a server:  docker compose --profile obs up -d mlflow
#
# SETTING THE TRACKING URI IS WHAT TURNS THIS ON — there is no separate flag
# (the old `obs.mlflow` / PRAMANYX_OBS_MLFLOW was deleted 2026-07-31; it was a
# no-op without a server and inert with one). Unset the URI and restart to
# disable.
# PRAMANYX_MLFLOW_TRACKING_URI=http://localhost:5001
# PRAMANYX_MLFLOW_EXPERIMENT=pramanyx

# ── Observability (OTLP — bring your own backend) ─────────────────────────────
# One telemetry contract, any backend. Phases, guarded SQL, delegation hops and
# every model call (with provider, model and token counts) are exported as
# OpenTelemetry spans carrying the GenAI semantic conventions, so Jaeger, Grafana
# Tempo, an otel-collector or Langfuse all read them without a plugin.
#
# SETTING THE ENDPOINT IS WHAT TURNS THIS ON. Unset means no export and zero
# egress — local-first, the same posture as bring-your-own-key.
# PRAMANYX_OTLP_ENDPOINT=http://localhost:4318/v1/traces
#
# Transport defaults to OTLP/HTTP, which is what every backend above accepts from
# a pasted URL. Set grpc (and a host:port endpoint) if your collector wants it.
# PRAMANYX_OTLP_PROTOCOL=grpc
#
# Headers in OpenTelemetry's own `k=v,k=v` format, so a line copied from any
# vendor's docs works as-is.
# PRAMANYX_OTLP_HEADERS=authorization=Bearer xxx,x-scope-orgid=acme
#
# ⚠️ WHAT LEAVES THE MACHINE, PRECISELY:
#   • Always — the MEASUREMENT: model, provider, token counts, latency, errors,
#     span names, and the operational attributes a span exists to explain, which
#     for a `sql.execute` span includes the generated SQL (capped at 2,000 chars).
#     A trace you cannot read the query off is not worth exporting.
#   • Only inside an open prompt-capture window — PROMPT AND RESPONSE TEXT. Setting
#     the endpoint does not start shipping it; the window is the same single gate
#     the local session log uses, and it is closed by default.
#
# Langfuse needs no endpoint of its own — its keys are picked up directly and
# spans go to {LANGFUSE_HOST}/api/public/otel/v1/traces over the same pipeline.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
